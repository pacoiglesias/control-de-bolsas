# ─── Plantilla de Variables de Entorno ────────────────────────────────────────
# Copia este archivo como .env.development, .env.staging o .env.production
# y rellena los valores reales. NUNCA commitees los archivos con valores reales.
#
# En CI/CD (GitHub Actions), estas variables se configuran como Secrets del repo:
#   Settings > Secrets and variables > Actions > New repository secret

VITE_ENV=development

# Firebase — obtenlos desde Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:your-app-id

# Flags opcionales
VITE_APP_VERSION=dev-local
VITE_LOG_LEVEL=debug
# VITE_USE_EMULATOR=true
