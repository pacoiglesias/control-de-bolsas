rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función principal para verificar si el usuario es administrador.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.admin == true ||
          (request.auth.token.email != null && (
            request.auth.token.email == "paco.iglesias@gmail.com" ||
            request.auth.token.email == "pacoismael@gmail.com" ||
            request.auth.token.email.matches(".*@cobertores\\.com")
          ))
        );
    }

    // Un usuario existe en la plataforma si es admin o tiene documento de usuario normal/manager.
    function isAuthenticatedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || isAdmin()
        );
    }

    function getRole() {
      return isAdmin() 
        ? 'admin' 
        : get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isAdmin() || (isAuthenticatedUser() && getRole() == 'admin');
    }

    function isManagerOrAdmin() {
      return isSuperAdmin() || (isAuthenticatedUser() && getRole() == 'manager');
    }

    function esAdminReal() {
      return isSuperAdmin();
    }

    function isAllowedOwnerEmail() {
      return isAdmin();
    }

    match /admins/{uid} {
      // Cada quien ve su propio permiso; un admin ve la lista completa
      // para poder administrarla desde la pantalla de Usuarios.
      allow read: if request.auth != null && (request.auth.uid == uid || esAdminReal());

      // Alta: o eres un correo dueño creando tu propio acceso la primera
      // vez (arranque del sistema), o eres un admin dando de alta a otro.
      allow create: if request.auth != null && (
        (request.auth.uid == uid && isAllowedOwnerEmail())
        || esAdminReal()
      );

      // Cambio de rol: solo un admin, y NUNCA sobre si mismo. Asi nadie se
      // sube el rol solo, y nadie se degrada por accidente dejando el
      // sistema sin ningun administrador.
      allow update: if esAdminReal() && request.auth.uid != uid;

      // Baja: solo un admin, y tampoco sobre si mismo, para no dejar el
      // sistema cerrado sin nadie que pueda entrar a arreglarlo.
      allow delete: if esAdminReal() && request.auth.uid != uid;
    }

    match /purchaseOrders/{orderId} {
      // Todos los usuarios pueden leer expedientes (para empaquetar, checar estatus)
      allow read: if isAuthenticatedUser();
      // Managers y admins pueden crear/editar (uso diario del sistema).
      allow create, update: if isManagerOrAdmin();
      // Eliminar es mas sensible que editar -- en esta misma sesion se
      // elimino por accidente un expediente con contrarecibos reales,
      // mas de una vez. La proteccion de la interfaz (doble clic) ya se
      // corrigio, pero la base de datos en si nunca distinguio "borrar"
      // de "editar": cualquier manager podia hacer ambas cosas por
      // igual. Ahora borrar requiere el nivel mas alto (super admin).
      allow delete: if isSuperAdmin();
    }

    // Paso 1 de la migracion planeada (PLAN_DE_MEJORA_TOTAL.md, 3.4):
    // coleccion nueva, en paralelo, donde cada factura vive como su
    // propio documento -- se escribe en espejo junto al modelo actual,
    // sin que ningun archivo existente dependa todavia de ella.
    match /invoices/{invoiceId} {
      allow read: if isAuthenticatedUser();
      allow write: if isManagerOrAdmin();
      allow delete: if isSuperAdmin();
    }

    match /ledger/{ledgerId} {
      allow read: if isAuthenticatedUser();
      allow write: if isManagerOrAdmin();
      allow delete: if isSuperAdmin();
    }

    // Catalogo de productos. Se alimenta solo desde OrderModal al guardar las
    // partidas de un expediente. Sin esta regla, la coleccion caia en el
    // match /{document=**} final: la pantalla Catalogo no cargaba nunca y el
    // guardado de cualquier expediente con partidas terminaba en error.
    match /products/{productId} {
      allow read: if isAuthenticatedUser();
      allow write: if isManagerOrAdmin();
    }

    match /price_lists/{listId} {
      allow read: if isAuthenticatedUser();
      allow write: if isManagerOrAdmin();
    }

    // Copias completas del estado del respaldo HTML.
    // El documento padre guarda solo metadatos; el contenido pesado vive en la
    // subcoleccion blob/ para no descargarlo al listar.
    match /snapshots/{snapId} {
      allow read, write: if isSuperAdmin();
      match /{document=**} {
        allow read, write: if isSuperAdmin();
      }
    }

    match /config/{docId} {
      allow read: if isAuthenticatedUser();
      allow write: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      // El Super Admin puede leer y escribir.
      // El Maquilador (usuario anónimo sin rol) puede leer los egresos que pertenezcan a la categoría "Maquila".
      allow read: if isSuperAdmin() || (request.auth != null && resource.data.category == 'Maquila');
      allow write: if isSuperAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isSuperAdmin();
    }

    match /stats/{statId} {
      allow read: if isAuthenticatedUser();
    }
    
    match /maquilaDeliveries/{deliveryId} {
      allow read: if isAuthenticatedUser();
      // El maquilador se autentica anónimamente para enviar su reporte
      allow create: if request.auth != null;
      allow update, delete: if isManagerOrAdmin();
    }

    match /system_settings/global {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // El PIN del portal maquilador vive APARTE de system_settings/global.
    // Las reglas de Firestore son por documento, no por campo: si el PIN
    // siguiera en el documento publico de arriba (necesario para que Login
    // muestre el logo/nombre antes de autenticarse), cualquiera podria
    // leerlo directo sin necesidad de acertarlo. Solo el backend (Cloud
    // Functions, que usa el Admin SDK y no pasa por estas reglas) necesita
    // leerlo de verdad.
    match /system_settings_private/maquila {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Log de auditoría
    match /system_logs/{logId} {
      // Solo super admin lee los logs
      allow read: if isSuperAdmin();
      // Append-only con identidad y sello de tiempo verificados.
      //
      // request.resource.data.timestamp == request.time SI funciona con
      // serverTimestamp(): Firestore lo resuelve ANTES de evaluar las reglas y
      // lo hace igual a request.time. Es el patron que documenta Firebase para
      // forzar sellos del servidor. Lo que rompia antes era la comparacion de
      // correo sin normalizar; ahora logger.ts envia el correo en minusculas.
      //
      // Sin la comparacion de identidad, hasAll() solo comprueba que las llaves
      // existan: cualquier usuario podia firmar una entrada con el correo de
      // otro y la bitacora dejaba de tener valor probatorio.
      allow create: if isAuthenticatedUser()
        && request.resource.data.keys().hasAll(['user', 'action', 'timestamp'])
        && request.auth.token.email != null
        && request.resource.data.user == request.auth.token.email.lower()
        && request.resource.data.timestamp == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Logs de errores del frontend
    match /error_logs/{logId} {
      allow read: if isSuperAdmin();
      // Solo usuarios autenticados pueden reportar errores. "if true" abriría
      // la colección a escritura anónima masiva (flood/DDoS de Firestore).
      // Si se necesita capturar errores pre-login, hacerlo via Cloud Function
      // con validación de estructura y rate-limiting del lado del servidor.
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /presence/{uid} {
      allow read: if isAuthenticatedUser();
      allow write: if isAuthenticatedUser() && request.auth.uid == uid;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
