rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedOwnerEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == "paco.iglesias@gmail.com"
          || request.auth.token.email == "pacoismael@gmail.com"
          || request.auth.token.email == "paco@cobertores.com"
          || request.auth.token.email.matches(".*@ruenisco\\.com$")
          || request.auth.token.email.matches("^admin@.*")
        );
    }

    function isAdmin() {
      return request.auth != null
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || isAllowedOwnerEmail()
        );
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isAllowedOwnerEmail();
      allow delete: if false;
    }

    match /purchaseOrders/{orderId} {
      allow read: if isAdmin();
      // El backend escribe con Admin SDK y se salta estas reglas;
      // esto habilita la edición manual desde la interfaz.
      allow create, update, delete: if isAdmin();
    }

    // Copias completas del estado del respaldo HTML (un solo documento grande).
    match /snapshots/{snapId} {
      allow read, write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
