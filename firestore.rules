rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo correos concretos. NUNCA patrones abiertos como "^admin@.*":
    // cualquiera se registra con admin@loquesea.com contra la API publica
    // de Firebase Auth y queda con control total de los datos.
    function isAllowedOwnerEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && (
          request.auth.token.email == "paco.iglesias@gmail.com"
          || request.auth.token.email == "pacoismael@gmail.com"
          || request.auth.token.email == "paco@cobertores.com"
          || request.auth.token.email.matches(".*@ruenisco\\.com$")
        );
    }

    // Un usuario existe en la plataforma si es owner o tiene documento con email verificado.
    function isAuthenticatedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || isAllowedOwnerEmail()
        );
    }

    function getRole() {
      return isAllowedOwnerEmail() 
        ? 'admin' 
        : get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isAuthenticatedUser() && getRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return isAuthenticatedUser() && (getRole() == 'admin' || getRole() == 'manager');
    }

    // Un administrador de verdad: existe su documento Y su rol es 'admin' con correo verificado.
    function esAdminReal() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{uid} {
      // Cada quien ve su propio permiso; un admin ve la lista completa
      // para poder administrarla desde la pantalla de Usuarios.
      allow read: if request.auth != null && (request.auth.uid == uid || esAdminReal());

      // Alta: o eres un correo dueño creando tu propio acceso la primera
      // vez (arranque del sistema), o eres un admin dando de alta a otro.
      allow create: if request.auth != null && (
        (request.auth.uid == uid && isAllowedOwnerEmail())
        || esAdminReal()
      );

      // Cambio de rol: solo un admin, y NUNCA sobre si mismo. Asi nadie se
      // sube el rol solo, y nadie se degrada por accidente dejando el
      // sistema sin ningun administrador.
      allow update: if esAdminReal() && request.auth.uid != uid;

      // Baja: solo un admin, y tampoco sobre si mismo, para no dejar el
      // sistema cerrado sin nadie que pueda entrar a arreglarlo.
      allow delete: if esAdminReal() && request.auth.uid != uid;
    }

    match /purchaseOrders/{orderId} {
      // Todos los usuarios pueden leer expedientes (para empaquetar, checar estatus)
      allow read: if isAuthenticatedUser();
      // Solo admins y managers pueden crear/modificar/borrar expedientes
      allow create, update, delete: if isManagerOrAdmin();
    }

    // Copias completas del estado del respaldo HTML (un solo documento grande).
    match /snapshots/{snapId} {
      allow read, write: if isSuperAdmin();
    }

    match /config/{docId} {
      allow read: if isAuthenticatedUser();
      allow write: if isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSuperAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isSuperAdmin();
    }

    // Log de auditoría
    match /system_logs/{logId} {
      // Solo super admin lee los logs
      allow read: if isSuperAdmin();
      // El backend los genera o el cliente validado
      allow create: if isAuthenticatedUser()
        && request.resource.data.keys().hasAll(['user', 'action', 'timestamp']);
      allow update, delete: if false; // Logs inmutables
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
