rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Solo correos concretos. NUNCA patrones abiertos como "^admin@.*":
    // cualquiera se registra con admin@loquesea.com contra la API publica
    // de Firebase Auth y queda con control total de los datos.
    function isAllowedOwnerEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == "paco.iglesias@gmail.com"
          || request.auth.token.email == "pacoismael@gmail.com"
          || request.auth.token.email == "paco@cobertores.com"
          || request.auth.token.email.matches(".*@ruenisco\\.com$")
        );
    }

    function isAdmin() {
      return request.auth != null
        && (
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
          || isAllowedOwnerEmail()
        );
    }

    // Solo PDFs, máximo 20 MB, solo administradores, solo bajo uploads/.
    match /uploads/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
