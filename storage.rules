rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Solo correos concretos de arranque seguro. NUNCA patrones abiertos como "^admin@.*":
    // cualquiera se registra con admin@loquesea.com contra la API publica
    // de Firebase Auth y queda con control total de los datos.
    function isAllowedOwnerEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && (
          request.auth.token.email == "paco.iglesias@gmail.com"
          || request.auth.token.email == "pacoismael@gmail.com"
        );
    }

    function hasAdminClaim() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    function hasManagerClaim() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.role == 'manager' || hasAdminClaim());
    }

    function isManagerOrAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          hasManagerClaim()
          || (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) 
              && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'manager'])
          || isAllowedOwnerEmail()
        );
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          hasAdminClaim()
          || (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) 
              && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin')
          || isAllowedOwnerEmail()
        );
    }

    // PDFs o XMLs, maximo 5 MB, solo admin/manager, solo bajo uploads/.
    // Los 5 MB son el limite real que procesa parseUploadedPDF (el PDF viaja a
    // Gemini en base64). Si se cambia aqui, cambiar tambien MAX_UPLOAD_MB en
    // functions/src/index.ts, MAX_MB en src/pages/Upload.tsx y SECURITY.md.
    match /uploads/{fileName} {
      allow read: if isManagerOrAdmin();
      allow create: if isManagerOrAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType == 'application/xml' || request.resource.contentType == 'text/xml');
      allow update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    match /identidad/{fileName} {
      allow read: if true;
      allow create: if isManagerOrAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if isManagerOrAdmin();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
